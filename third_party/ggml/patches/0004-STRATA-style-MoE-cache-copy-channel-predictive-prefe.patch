From 22ef875fcde1109e8cf94722bdb4c458fa2258a3 Mon Sep 17 00:00:00 2001
From: ash-eriga <347392360+ash-eriga@users.noreply.github.com>
Date: Sat, 21 Nov 2026 09:37:06 -0300
Subject: [PATCH 4/8] STRATA-style MoE cache: copy channel + predictive
 prefetch (opt-in)

ggml-cuda: dedicated H2D copy stream + two events exported as
ggml_backend_strata_copy_{h2d,mark,wait} proc addresses.
moe-cache: uploads go on the copy stream; layer i+1's predicted
experts (from the previous ubatch's selection) are prefetched via a
safe-victim LRU path that never evicts in-flight selections.

Measured on GTX 1060 (LFM2.5-24B IQ2_XXS + DSpark): regresses vs the
serialized pinned path (43.4 -> 41.8 stream-only, -> 40.2 with
prefetch) - on a bandwidth-bound GPU the copies steal DRAM/PCIe time
from the expert GEMM. Disabled by default; enable with
LLAMA_MOE_CACHE_STRATA=1 (prefetch off: LLAMA_MOE_CACHE_NO_PREFETCH=1).
---
 ggml/src/ggml-cuda/ggml-cuda.cu |  54 ++++++++++
 src/llama-moe-cache.cpp         | 176 +++++++++++++++++++++++++++++---
 2 files changed, 216 insertions(+), 14 deletions(-)

diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 3e1f167..60a1711 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -6131,6 +6131,51 @@ bool ggml_backend_cuda_register_host_buffer(void * buffer, size_t size) {
 #endif // CUDART_VERSION >= 11010 || defined(GGML_USE_MUSA)
 }
 
+
+// STRATA-style copy channel: a dedicated H2D copy stream + two events so MoE cache
+// uploads (0 = real fills, 1 = speculative prefetch) overlap the compute stream.
+struct ggml_cuda_strata_copy_channel {
+    cudaStream_t stream = nullptr;
+    cudaEvent_t  ev[2]  = {nullptr, nullptr};
+};
+
+static ggml_cuda_strata_copy_channel & ggml_cuda_strata_copy_channel_get(ggml_backend_t backend) {
+    static std::map<ggml_backend_t, ggml_cuda_strata_copy_channel> channels;
+    auto & ch = channels[backend];
+    if (ch.stream == nullptr) {
+        ggml_backend_cuda_context * cuda_ctx = (ggml_backend_cuda_context *) backend->context;
+        cudaSetDevice(cuda_ctx->device);
+        cudaStreamCreateWithFlags(&ch.stream, cudaStreamNonBlocking);
+        cudaEventCreateWithFlags(&ch.ev[0], cudaEventDisableTiming);
+        cudaEventCreateWithFlags(&ch.ev[1], cudaEventDisableTiming);
+    }
+    return ch;
+}
+
+// enqueue dst <- src (pinned host) on the copy stream; returns false on failure
+bool ggml_backend_cuda_strata_copy_h2d(ggml_backend_t backend, void * dst, const void * src, size_t size) {
+    ggml_cuda_strata_copy_channel & ch = ggml_cuda_strata_copy_channel_get(backend);
+    cudaError_t err = cudaMemcpyAsync(dst, src, size, cudaMemcpyHostToDevice, ch.stream);
+    if (err != cudaSuccess) {
+        (void) cudaGetLastError();
+        return false;
+    }
+    return true;
+}
+
+// record event `which` (0/1) on the copy stream
+bool ggml_backend_cuda_strata_copy_mark(ggml_backend_t backend, int which) {
+    ggml_cuda_strata_copy_channel & ch = ggml_cuda_strata_copy_channel_get(backend);
+    return cudaEventRecord(ch.ev[which & 1], ch.stream) == cudaSuccess;
+}
+
+// make the backend's compute stream wait on event `which` (0/1)
+bool ggml_backend_cuda_strata_copy_wait(ggml_backend_t backend, int which) {
+    ggml_cuda_strata_copy_channel & ch = ggml_cuda_strata_copy_channel_get(backend);
+    ggml_backend_cuda_context * cuda_ctx = (ggml_backend_cuda_context *) backend->context;
+    return cudaStreamWaitEvent(cuda_ctx->stream(), ch.ev[which & 1], 0) == cudaSuccess;
+}
+
 void ggml_backend_cuda_unregister_host_buffer(void * buffer) {
     if (!ggml_cuda_register_host_enabled()) {
         return;
@@ -7025,6 +7070,15 @@ static void * ggml_backend_cuda_reg_get_proc_address(ggml_backend_reg_t reg, con
     if (strcmp(name, "ggml_backend_unregister_host_buffer") == 0) {
         return (void *)ggml_backend_cuda_unregister_host_buffer;
     }
+    if (strcmp(name, "ggml_backend_strata_copy_h2d") == 0) {
+        return (void *)ggml_backend_cuda_strata_copy_h2d;
+    }
+    if (strcmp(name, "ggml_backend_strata_copy_mark") == 0) {
+        return (void *)ggml_backend_cuda_strata_copy_mark;
+    }
+    if (strcmp(name, "ggml_backend_strata_copy_wait") == 0) {
+        return (void *)ggml_backend_cuda_strata_copy_wait;
+    }
     if (strcmp(name, "ggml_backend_get_features") == 0) {
         return (void *)ggml_backend_cuda_get_features;
     }
diff --git a/src/llama-moe-cache.cpp b/src/llama-moe-cache.cpp
index c186841..9995051 100644
--- a/src/llama-moe-cache.cpp
+++ b/src/llama-moe-cache.cpp
@@ -176,11 +176,81 @@ struct moe_cache_lru {
         return res;
     }
 
+    // STRATA-style safe victim: like victim(), but also skips slots holding experts
+    // selected by layer `protected_il`'s latest plan (its GEMM may still be in flight).
+    int32_t victim_safe(int32_t il, int32_t protected_il) const {
+        int32_t res = -1;
+        double res_score = -1.0;
+        for (int c = 0; c < n_class; ++c) {
+            int32_t s = -1;
+            for (int32_t t = head[c]; t >= 0; t = next[t]) {
+                if (is_selected(il, key_of[t]) || is_selected(protected_il, key_of[t])) {
+                    continue;
+                }
+                s = t;
+                break;
+            }
+            if (s < 0) {
+                continue;
+            }
+            const int32_t key = key_of[s];
+            if (key < 0) {
+                return s; // unused slot
+            }
+            const int64_t age   = clock[key_layer(key)] - last_use[key];
+            const double  score = std::ldexp((double) age, -c);
+            if (score > res_score) {
+                res       = s;
+                res_score = score;
+            }
+        }
+        return res;
+    }
+
     struct fill {
         int32_t expert;
         int32_t slot;
     };
 
+    // STRATA-style speculative prefetch: put layer il's predicted experts into free/cold
+    // slots without touching CRF/clock/seen (a wrong guess only wastes PCIe bandwidth).
+    // Slots in protected_il's in-flight plan are never evicted.
+    size_t prefetch(int32_t il, int32_t protected_il, const int32_t * ids, size_t n_ids, std::vector<fill> & fills) {
+        fills.clear();
+        for (size_t i = 0; i < n_ids; ++i) {
+            const int32_t e = ids[i];
+            bool dup = false;
+            for (size_t j = 0; j < i; ++j) {
+                if (ids[j] == e) {
+                    dup = true;
+                    break;
+                }
+            }
+            if (dup) {
+                continue;
+            }
+            if (slot_map[il][e] < n_slots) {
+                continue; // already resident
+            }
+            const int32_t s = victim_safe(il, protected_il);
+            if (s < 0) {
+                break;
+            }
+            const int32_t key = make_key(il, e);
+            if (key_of[s] >= 0) {
+                slot_map[key_layer(key_of[s])][key_expert(key_of[s])] = empty;
+            } else {
+                n_filled++;
+            }
+            key_of[s]       = key;
+            slot_map[il][e] = s;
+            move(s, class_of(key));
+            fills.push_back({ e, s });
+        }
+        return fills.size();
+    }
+
+
     // give a slot to each expert selected by ids (n_tokens tokens) in layer il
     // n_cpu(n) of the n misses are left to the CPU and read a zero slot on the device, they are not cached
     // a zero slot is used at most once per token, a miss that does not get one is cached instead
@@ -385,6 +455,11 @@ struct llama_moe_cache::impl {
     std::vector<moe_cache_lru::fill> fills;
     std::vector<moe_cache_lru::fill> cpu;
 
+    // STRATA-style prefetch: expert ids each model layer used in the previous ubatch,
+    // used to predict this ubatch's experts one layer ahead (indexed by model layer)
+    std::vector<std::vector<int32_t>> prev_sel;
+    size_t bytes_prefetch = 0; // uploaded by speculative prefetches (STRATA-style)
+
     float    cpu_share = 0.0f;
     uint32_t cpu_share_q = 0; // cpu_share in 1/65536, integer so that a simulator can reproduce the rounding
     int32_t  n_zero    = 0; // zero slots per group
@@ -788,6 +863,10 @@ struct llama_moe_cache::impl {
         const int32_t il      = it->second.first;
         const bool    has_cpu = it->second.second;
         layer & l = layers[il];
+
+        if (prev_sel.size() != layers.size()) {
+            prev_sel.resize(layers.size());
+        }
         group & g = groups[l.ig];
 
         GGML_ASSERT(backend == devices[g.id].backend);
@@ -848,23 +927,88 @@ struct llama_moe_cache::impl {
             }
         }
 
-        // upload the missing experts, consecutive experts going to consecutive slots are uploaded together
-        size_t bytes = 0;
-        for (size_t ip = 0; ip < l.experts.size(); ++ip) {
-            const ggml_tensor * w    = l.experts[ip];
-            ggml_tensor       * bank = g.banks[ip];
-            const size_t expert_size = w->nb[2];
-            for (size_t i = 0; i < fills.size();) {
-                size_t n = 1;
-                while (i + n < fills.size() && fills[i + n].expert == fills[i].expert + (int32_t) n && fills[i + n].slot == fills[i].slot + (int32_t) n) {
-                    n++;
-                }
-                ggml_backend_tensor_set_async(backend, bank, (const uint8_t *) w->data + fills[i].expert*expert_size, fills[i].slot*expert_size, n*expert_size);
-                bytes += n*expert_size;
-                i += n;
+        // STRATA-style copy channel (dedicated H2D stream + 2 events):
+        // event 0 = this layer's real fills, event 1 = prefetches issued one layer ahead.
+        struct strata_fns {
+            bool (*h2d )(ggml_backend_t, void *, const void *, size_t) = nullptr;
+            bool (*mark)(ggml_backend_t, int) = nullptr;
+            bool (*wait)(ggml_backend_t, int) = nullptr;
+        };
+        static strata_fns strata;
+        static std::unordered_set<ggml_backend_t> strata_seen;
+        static const bool strata_off = getenv("LLAMA_MOE_CACHE_STRATA") == nullptr;
+        if (strata_seen.insert(backend).second && !strata_off) {
+            auto * reg = ggml_backend_dev_backend_reg(ggml_backend_get_device(backend));
+            strata.h2d  = (decltype(strata.h2d))  ggml_backend_reg_get_proc_address(reg, "ggml_backend_strata_copy_h2d");
+            strata.mark = (decltype(strata.mark)) ggml_backend_reg_get_proc_address(reg, "ggml_backend_strata_copy_mark");
+            strata.wait = (decltype(strata.wait)) ggml_backend_reg_get_proc_address(reg, "ggml_backend_strata_copy_wait");
+            if (strata.h2d == nullptr || strata.mark == nullptr || strata.wait == nullptr) {
+                strata.h2d  = nullptr;
+                strata.mark = nullptr;
+                strata.wait = nullptr;
             }
         }
 
+        // consecutive experts going to consecutive slots are uploaded together;
+        // with a copy channel the uploads go to the dedicated H2D stream
+        auto upload_fills = [&](layer & lw, group & gw, const std::vector<moe_cache_lru::fill> & fl, size_t & out_bytes) {
+            for (size_t ip = 0; ip < lw.experts.size(); ++ip) {
+                const ggml_tensor * w    = lw.experts[ip];
+                ggml_tensor       * bank = gw.banks[ip];
+                const size_t expert_size = w->nb[2];
+                for (size_t i = 0; i < fl.size();) {
+                    size_t n = 1;
+                    while (i + n < fl.size() && fl[i + n].expert == fl[i].expert + (int32_t) n && fl[i + n].slot == fl[i].slot + (int32_t) n) {
+                        n++;
+                    }
+                    if (strata.h2d != nullptr) {
+                        strata.h2d(backend, (char *) bank->data + fl[i].slot*expert_size,
+                                   (const uint8_t *) w->data + fl[i].expert*expert_size, n*expert_size);
+                    } else {
+                        ggml_backend_tensor_set_async(backend, bank, (const uint8_t *) w->data + fl[i].expert*expert_size, fl[i].slot*expert_size, n*expert_size);
+                    }
+                    out_bytes += n*expert_size;
+                    i += n;
+                }
+            }
+        };
+
+        size_t bytes = 0;
+        upload_fills(l, g, fills, bytes);
+
+        if (strata.h2d != nullptr) {
+            // make the compute stream see this layer's fills (event 0, just recorded)
+            // and the prefetches issued by the previous layer's copy() (event 1, older)
+            strata.mark(backend, 0);
+            strata.wait(backend, 0);
+            strata.wait(backend, 1);
+        }
+
+        // STRATA-style prefetch: upload the NEXT cached layer's predicted experts on the
+        // copy stream while the rest of this layer runs; event 1 is waited on next call
+        static const bool no_prefetch = getenv("LLAMA_MOE_CACHE_NO_PREFETCH") != nullptr;
+        if (strata.h2d != nullptr && !no_prefetch && !prev_sel.empty()) {
+            int32_t il_next = -1;
+            for (size_t i = 0; i + 1 < g.layers.size(); ++i) {
+                if (g.layers[i] == il) {
+                    il_next = g.layers[i + 1];
+                    break;
+                }
+            }
+            if (il_next >= 0 && !prev_sel[il_next].empty()) {
+                std::vector<moe_cache_lru::fill> pf;
+                g.lru.prefetch(il_next, il, prev_sel[il_next].data(), prev_sel[il_next].size(), pf);
+                size_t pf_bytes = 0;
+                if (!pf.empty()) {
+                    upload_fills(layers[il_next], g, pf, pf_bytes);
+                    bytes_prefetch += pf_bytes;
+                }
+            }
+            strata.mark(backend, 1);
+        }
+
+        prev_sel[il].assign(ids.begin(), ids.end());
+
         stats & st = ids.size() <= (size_t) 8*n_expert_used ? stats_small : stats_large;
         st.hits   += n_hit;
         st.misses += fills.size() + cpu.size();
@@ -885,9 +1029,13 @@ struct llama_moe_cache::impl {
             }
             LLAMA_LOG_INFO("llama_moe_cache: %s: hits = %zu, misses = %zu (%zu on the CPU), hit rate = %.2f%%, uploaded = %.2f MiB\n",
                 name, st.hits, st.misses, st.cpu, 100.0*st.hits/n, st.bytes/1024.0/1024.0);
+
         };
         log("ubatch <= 8", stats_small);
         log("ubatch  > 8", stats_large);
+        if (bytes_prefetch > 0) {
+            LLAMA_LOG_INFO("llama_moe_cache: prefetched = %.2f MiB\n", bytes_prefetch/1024.0/1024.0);
+        }
         if (stats_copy.hits > 0) {
             LLAMA_LOG_INFO("llama_moe_cache: large batches: %zu experts copied from the cache, %.2f MiB\n", stats_copy.hits, stats_copy.bytes/1024.0/1024.0);
         }
-- 
